# ============================================================
# Jerry Can — Environment Variables (Example)
# ============================================================
# Copy this file to .env and adjust the values below.
#
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# ============================================================

# Django secret key — MUST be unique and kept secret in production.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# Set to False in production. Only set to True for local development.
DJANGO_DEBUG=False

# Comma-separated list of hostnames the server will accept.
# Add your domain name and/or IP address here.
# Example: jerrycan.example.com,www.jerrycan.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins allowed for CSRF.
# Must include the scheme (http:// or https://).
# Example: https://jerrycan.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Directory for the SQLite database file.
# In Docker, this should point to the persistent volume.
# For local development without Docker, leave commented out (defaults to project dir).
DJANGO_DB_DIR=/app/data

# Port exposed by nginx on the host machine.
NGINX_PORT=8080
