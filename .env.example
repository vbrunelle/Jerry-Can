# URL de l'API ou du fichier Excel des prix d'essence
# Exemples :
#   JSON : https://regieessencequebec.ca/api/stations
#   Excel : https://regieessencequebec.ca/export/stations.xlsx
FUEL_PRICE_URL=https://regieessencequebec.ca/api/stations

# Chemin vers la base de données SQLite
DATABASE_PATH=fuel_prices.db

# Intervalle de récupération en minutes (défaut : 5)
FETCH_INTERVAL_MINUTES=5

# Délai d'expiration des requêtes HTTP en secondes
REQUEST_TIMEOUT=30
