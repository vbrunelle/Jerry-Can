# ── Data source ──────────────────────────────────────────────────────────────
# URL du GeoJSON des prix d'essence (Régie de l'énergie du Québec)
GEOJSON_URL=https://regieessencequebec.ca/stations.geojson.gz

# ── Fetch behaviour ───────────────────────────────────────────────────────────
# Intervalle de récupération des données en minutes (défaut : 5)
FETCH_INTERVAL_MINUTES=5
# Intervalle de rafraîchissement du cache d'inspection en minutes (défaut : 5)
# Ceci contrôle la fréquence de la cron job du serveur de gestion, indépendant
# de l'intervalle de récupération des données (FETCH_INTERVAL_MINUTES).
INSPECTION_REFRESH_INTERVAL_MINUTES=5
# Délai d'expiration des requêtes HTTP en secondes
REQUEST_TIMEOUT=30

# ── Persistence backend: "hudi" (défaut) ou "sqlite" ─────────────────────────
PERSISTENCE_BACKEND=hudi

# ── Dossier hôte où les données sont persistées entre les runs ───────────────
# Chemin relatif (depuis le projet) ou absolu.
# Ce dossier est monté dans le conteneur Docker sous /data.
DATA_DIR=./data

# ── SQLite (utilisé uniquement si PERSISTENCE_BACKEND=sqlite) ────────────────
# Chemin du fichier SQLite à l'intérieur du conteneur
DATABASE_PATH=/data/fuel_prices.db

# ── Apache Hudi (utilisé par défaut) ─────────────────────────────────────────
# Chemin du tableau Hudi (local, HDFS ou S3)
HUDI_TABLE_PATH=/data/hudi/fuel_prices
# Nom logique du tableau Hudi
HUDI_TABLE_NAME=fuel_prices
# Parallélisme Spark pour les upserts Hudi
HUDI_PARALLELISM=2

# ── Django Management Server ─────────────────────────────────────────────────
# Mot de passe initial de l'administrateur (requis au premier démarrage)
DJANGO_ADMIN_PASSWORD=changeme
# Clé secrète Django (générer une clé unique pour la production)
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
# Mode debug Django (False en production)
DJANGO_DEBUG=False
# Hôtes autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines de confiance pour CSRF (séparées par des virgules)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ── Nginx ─────────────────────────────────────────────────────────────────────
# Port exposé par nginx sur l'hôte
NGINX_PORT=80
# Taille maximale des requêtes (uploads)
NGINX_CLIENT_MAX_BODY_SIZE=10M

# ── Gunicorn ──────────────────────────────────────────────────────────────────
# Nombre de workers gunicorn
GUNICORN_WORKERS=3
# Délai d'expiration gunicorn en secondes
GUNICORN_TIMEOUT=120
