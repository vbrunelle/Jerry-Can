# ============================================================
# Jerry Can — Environment Variables (Example)
# ============================================================
# Copy this file to .env and adjust the values below.
#
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# ============================================================

# Django secret key — MUST be unique and kept secret in production.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# Set to False in production. Only set to True for local development.
DJANGO_DEBUG=False

# Comma-separated list of hostnames the server will accept.
# Add your domain name and/or IP address here.
# Example: jerrycan.example.com,www.jerrycan.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins allowed for CSRF.
# Must include the scheme (http:// or https://).
# Example: https://jerrycan.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Directory for the SQLite database file.
# In Docker, this should point to the persistent volume.
# For local development without Docker, leave commented out (defaults to project dir).
DJANGO_DB_DIR=/app/data

# Port exposed by nginx on the host machine.
NGINX_PORT=8080

# Nginx configuration injected into /etc/nginx/conf.d/default.conf at container startup.
# The value must be a single line: use \n for newlines to represent line breaks.
# Nginx variables such as $host or $remote_addr do NOT need escaping here — Docker Compose
# does not perform variable substitution on values in .env files, so they are passed as-is.
# (If you were to write this value directly in docker-compose.yml instead of .env, you would
# need to escape $ as $$ to prevent Docker Compose interpolation.)
# Example below is a full reverse-proxy configuration pointing to the internal web service
# on port 8000. Adjust proxy_pass if your web service listens on a different port.
NGINX_CONF=upstream django {\n    server web:8000;\n}\n\nserver {\n    listen 80;\n    server_name _;\n\n    client_max_body_size 10M;\n\n    location /static/ {\n        alias /app/staticfiles/;\n        expires 30d;\n        add_header Cache-Control "public, immutable";\n    }\n\n    location / {\n        proxy_pass http://django;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n        proxy_redirect off;\n    }\n}
