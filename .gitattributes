# Force LF pour tous les fichiers texte — évite les CRLF sur Windows
* text=auto eol=lf

# Scripts Windows : conserver CRLF pour la compatibilité cmd.exe
*.bat       text eol=crlf
*.cmd       text eol=crlf
# Fichiers qui doivent absolument être LF (scripts shell, configs)
*.sh        text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
Dockerfile  text eol=lf
